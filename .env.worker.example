# Worker environment — copy to `.env.worker` and fill in.
#
# These are the variables the schedulers need. They don't serve HTTP or verify
# JWTs, so the API's auth/agent/quick-meet secrets don't belong here. The one
# exception is S3: with EOD_VISION_ENABLED the EOD scheduler reads sampled
# screenshot images from S3, so it then needs the AWS_* vars below too. Keep this
# file out of git (it's gitignored like `.env`).
#
# Local run:
#   set -a; source .env.worker; set +a
#   uv run python -m worker.eod_scheduler      # or worker.payroll_scheduler
# (Exported vars win over any `.env` in the directory, so the API's `.env`
#  won't bleed in.)
#
# On Render: paste these into the worker service's env vars (or a shared
# Environment Group), not a file.
#
# NOTE: this is the ALWAYS-ON worker path (paid hosts / self-hosting). On Render's
# FREE tier you can't run a worker — instead set these EOD_* vars on the API and
# trigger POST /eod/cron from a free scheduler. See docs/deploy-eod-free-render.md.

ENVIRONMENT=production
LOG_LEVEL=INFO

# The SAME Postgres the API uses (asyncpg URL).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Email delivery — needed to send the reports/digests.
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=Avora

# --- End-of-Day report scheduler (worker/eod_scheduler.py) --------------------
EOD_ENABLED=true
OPENROUTER_API_KEY=                          # sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EOD_MODEL=                                   # e.g. anthropic/claude-sonnet-4.5
EOD_REPORT_HOUR=18                           # local hour (attendance-policy tz)
EOD_OCR_CHAR_BUDGET=12000
EOD_AUTO_SEND_AFTER_HOURS=16
EOD_TICK_SECONDS=900

# EOD vision (opt-in): analyse a few sampled screenshots/employee/day with a
# vision model for richer context. SENDS those images to the model. Needs the
# AWS_* block below so the scheduler can read S3-stored screenshots.
EOD_VISION_ENABLED=false
EOD_VISION_MODEL=                            # falls back to EOD_MODEL; e.g. anthropic/claude-haiku-4.5
EOD_VISION_SAMPLE_MAX=8
# Only needed when EOD_VISION_ENABLED=true (to fetch screenshot images from S3):
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Payroll digest scheduler (worker/payroll_scheduler.py), if you run it -----
PAYROLL_TICK_SECONDS=3600
