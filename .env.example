# --------------------------------------------------------------------------- #
# PMS Backend — example environment.
# Copy to `.env` for local dev. NEVER commit a real .env. NEVER log these.
# All secrets are loaded via app.core.config.Settings — never hardcoded.
# --------------------------------------------------------------------------- #

# Runtime
ENVIRONMENT=local              # local | staging | production
DEBUG=true                     # MUST be false in production
LOG_LEVEL=INFO

# Database — use a least-privilege role (no DDL/superuser from the app).
DATABASE_URL=postgresql+asyncpg://pms_app:change-me@localhost:5432/pms

# Human auth — Google OIDC -> short-lived signed JWT in httpOnly cookie.
JWT_SECRET=change-me-to-a-long-random-value
JWT_ISSUER=https://accounts.google.com
JWT_AUDIENCE=your-google-oauth-client-id.apps.googleusercontent.com
JWT_ACCESS_TTL_SECONDS=900     # 15 minutes
GOOGLE_OIDC_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Session cookie
SESSION_COOKIE_NAME=pms_session
COOKIE_SECURE=true             # MUST be true in production (HTTPS only)
COOKIE_DOMAIN=

# Agent ingest — per-device HMAC. The device secret lives in the DB per device;
# this pepper hardens token hashing at rest.
AGENT_TOKEN_PEPPER=change-me-to-a-long-random-value

# HR webhook — HMAC shared secret between HR system and PMS.
HR_WEBHOOK_SECRET=change-me-to-a-long-random-value
HR_WEBHOOK_IP_ALLOWLIST=        # comma-separated CIDRs/IPs; empty = allow all (dev only)

# Biometric attendance webhook — shared secret the office-PC connector signs
# punch batches with (HMAC). See integrations/biometric-connector/.
BIOMETRIC_WEBHOOK_SECRET=change-me-to-a-long-random-value
BIOMETRIC_IP_ALLOWLIST=         # comma-separated CIDRs/IPs of the office; empty = allow all (dev only)

# Quick Meet — one-click Google Meet + Slack share. Google Workspace service
# account with domain-wide delegation (scope meetings.space.created). From the
# service-account JSON: client_email + private_key. Feature is off until both set.
GOOGLE_SA_CLIENT_EMAIL=         # e.g. avora-meet@your-project.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY=          # PEM, one line with \n escapes: -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
GOOGLE_MEET_IMPERSONATE_SUBJECT=  # optional: always create as this Workspace user; empty = the clicker
SLACK_WEBHOOK_URL=              # Slack Incoming Webhook for the team channel

# CORS — the Next.js dashboard origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3000

# Transactional email (SendGrid) + invitations.
SENDGRID_API_KEY=SG.your-sendgrid-api-key
EMAIL_FROM=no-reply@signalor.ai
EMAIL_FROM_NAME=Avora
APP_BASE_URL=http://localhost:3000          # invite links point here: {app}/invite/<token>
INVITE_TOKEN_PEPPER=change-me-to-a-long-random-value
INVITE_TTL_HOURS=168

# Rate limiting (agent ingest), requests per minute per device.
AGENT_INGEST_RATE_PER_MINUTE=120

# Payroll scheduler (worker/payroll_scheduler.py) — sends the monthly HR salary
# digest on the configured pay day. Needs DATABASE_URL + the SendGrid vars above.
# Run as its own process: uv run python -m worker.payroll_scheduler
PAYROLL_TICK_SECONDS=3600                    # how often the scheduler checks the pay day

# End-of-Day reports (worker/eod_scheduler.py) — summarises each present
# employee's day via OpenRouter (text only), then emails manager + admins after
# the employee approves. Off until EOD_ENABLED=true AND a model+key are set.
# Run as its own process: uv run python -m worker.eod_scheduler
EOD_ENABLED=false                            # master switch for the feature
OPENROUTER_API_KEY=                          # OpenRouter API key (sk-or-...)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EOD_MODEL=                                   # OpenRouter model id, e.g. anthropic/claude-sonnet-4.5
EOD_REPORT_HOUR=18                           # local hour (attendance-policy tz) to generate drafts
EOD_OCR_CHAR_BUDGET=12000                    # cap OCR text fed to the LLM per employee
EOD_AUTO_SEND_AFTER_HOURS=16                 # unreviewed drafts auto-send after this many hours
EOD_TICK_SECONDS=900                         # how often the scheduler checks (15 min)
# Free-tier path (no always-on worker): an external cron calls POST /eod/cron
# with header `X-Cron-Secret: <this>`. Leave blank to disable the endpoint.
EOD_CRON_SECRET=
