# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
# DOMAIN and ACME_EMAIL are injected from .env.prod at container start.
#
# Caddy obtains + renews the TLS cert for $DOMAIN automatically; you only need a
# DNS A record for $DOMAIN pointing at this VPS's public IP, and ports 80+443
# open. HTTP is redirected to HTTPS by default.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Forward to the API by its UNAMBIGUOUS container name, not the `api` network
	# alias — another stack (circle-be-api) is attached to this Docker network with
	# the same `api` alias, so `api:8000` round-robins onto the wrong app. The
	# explicit container name only ever resolves to our PMS api.
	reverse_proxy deploy-api-1:8000

	# Caddy already sets sensible defaults; the app also emits its own security
	# headers (HSTS, X-Frame-Options, ...) via SecurityHeadersMiddleware.
	log {
		output stdout
		format console
	}
}
