# --------------------------------------------------------------------------- #
# PRODUCTION environment for the Hetzner VPS docker stack.
#
#   cp .env.prod.example .env.prod   then fill EVERY value below.
#   .env.prod holds real secrets — it is gitignored; NEVER commit it.
#
# Generate each secret with:   openssl rand -hex 32
# --------------------------------------------------------------------------- #

# === Runtime ================================================================ #
ENVIRONMENT=production          # MUST be 'production' (hides docs, enforces the
                                # secure-config check, disables auto-migrate)
DEBUG=false                     # MUST be false
LOG_LEVEL=INFO

# === Reverse proxy / TLS (used by Caddy) ==================================== #
DOMAIN=api.example.com          # the API hostname; needs a DNS A record -> this VPS
ACME_EMAIL=ops@example.com      # Let's Encrypt account email (renewal notices)

# === Self-hosted Postgres =================================================== #
# These configure the `db` container. The password MUST be identical to the one
# embedded in DATABASE_URL just below (same database, described two ways).
POSTGRES_USER=pms_app
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=pms

# App connection string. Host is the compose service name `db`. No SSL needed on
# the internal docker network. Keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://pms_app:CHANGE_ME_db_password@db:5432/pms

# Pool: pre-ping is unnecessary against a co-located, always-warm Postgres.
DB_POOL_PRE_PING=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# === Human auth — Better Auth (Next.js dashboard) =========================== #
# CRITICAL: point these at the DEPLOYED dashboard, not localhost, or every human
# login fails. Use the real https origin users visit.
BETTER_AUTH_JWKS_URL=https://app.example.com/api/auth/jwks
BETTER_AUTH_ISSUER=https://app.example.com
BETTER_AUTH_AUDIENCE=https://app.example.com

# Legacy symmetric JWT (internal tokens/tests only — still validated in prod).
JWT_SECRET=CHANGE_ME_jwt_secret
JWT_ISSUER=https://accounts.google.com
JWT_AUDIENCE=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# === Session cookie ========================================================= #
COOKIE_SECURE=true              # MUST be true (HTTPS only)
COOKIE_DOMAIN=

# === CORS + invite links ==================================================== #
# Dashboard origin(s), comma-separated. The browser app's real https origin.
CORS_ORIGINS=https://app.example.com
# Host every emailed/copied invite link points at (the dashboard, NOT this API).
APP_BASE_URL=https://app.example.com

# === Agent ingest =========================================================== #
AGENT_TOKEN_PEPPER=CHANGE_ME_agent_pepper
AGENT_INGEST_RATE_PER_MINUTE=120

# === HR webhook ============================================================= #
HR_WEBHOOK_SECRET=CHANGE_ME_hr_secret
HR_WEBHOOK_IP_ALLOWLIST=        # comma-separated HR source IPs (recommended in prod)

# === Biometric attendance webhook =========================================== #
BIOMETRIC_WEBHOOK_SECRET=CHANGE_ME_biometric_secret
BIOMETRIC_IP_ALLOWLIST=         # comma-separated office IPs (recommended in prod)

# === Transactional email (SendGrid) — used by API + payroll/auto-checkout === #
SENDGRID_API_KEY=SG.CHANGE_ME
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Avora
INVITE_TOKEN_PEPPER=CHANGE_ME_invite_pepper
INVITE_TTL_HOURS=168

# === Object storage (S3) — screenshots + workspace files + OCR worker ======= #
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-bucket
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# === End-of-Day reports (eod scheduler) — OpenRouter LLM ===================== #
OPENROUTER_API_KEY=CHANGE_ME
EOD_MODEL=anthropic/claude-sonnet-4.5
EOD_CRON_SECRET=                # only needed for the external-cron path; blank here
# The schedule (on/off + draft/send times) is managed in the app — Settings →
# EOD timing (Admin/HR). These only SEED the eod_settings row on first read;
# after that, edit it in the UI, not here. Send must be AFTER draft (review window).
EOD_ENABLED=true                # seed: feature on/off
EOD_REPORT_HOUR=16              # seed: draft hour (local tz)  → 4:30 PM IST
EOD_REPORT_MINUTE=30            # seed: draft minute
EOD_SEND_HOUR=18                # seed: auto-send hour         → 6:00 PM IST
EOD_SEND_MINUTE=0               # seed: auto-send minute

# === Auto-checkout scheduler ================================================ #
AUTO_CHECKOUT_ENABLED=true      # the scheduler runs but does nothing until true
AUTO_CHECKOUT_TICK_SECONDS=900
AUTO_CHECKOUT_IDLE_GRACE_MINUTES=30

# === Worker liveness heartbeats (optional; e.g. Better Stack) =============== #
# Each scheduler pings its URL after every successful tick; a missed ping alerts
# you. One URL per worker. Set each monitor's "expected period" to ~ tick + grace
# (eod/autocheckout ~15 min, payroll ~1 h). Unset = off.
HEARTBEAT_URL_EOD=
HEARTBEAT_URL_PAYROLL=
HEARTBEAT_URL_AUTOCHECKOUT=
HEARTBEAT_URL_OCR=               # OCR loops fast; pings throttled to ~60s (expect ~5 min)

# === OCR worker tunables (optional) ========================================= #
OCR_BATCH=3
OCR_IDLE_SLEEP=2
OCR_MAX_CHARS=20000

# === Monitoring retention =================================================== #
ACTIVITY_RETENTION_DAYS=30
SCREENSHOT_RETENTION_DAYS=30
ACTIVITY_PURGE_HOUR=3

# === Quick Meet (optional — leave blank to keep the feature off) ============ #
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_MEET_IMPERSONATE_SUBJECT=
SLACK_WEBHOOK_URL=

# === Env Sync (optional App Store feature — blank = off) ==================== #
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENVSYNC_FERNET_KEY=
