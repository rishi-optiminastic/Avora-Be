# Copy to .env (or set these as real environment variables) on the office PC.

# Where Avora's backend lives, and the shared secret (must equal the backend's
# BIOMETRIC_WEBHOOK_SECRET).
AVORA_API_URL=https://api.your-avora-host.com
BIOMETRIC_WEBHOOK_SECRET=change-me-to-a-long-random-value

# Where punches come from: "csv" (vendor middleware export) or "zk" (pull from a
# ZKTeco/eSSL-family device over the LAN; needs `pip install pyzk`).
SOURCE=csv

# --- SOURCE=csv ---
# A file the middleware writes, with a header row: external_id,punched_at[,direction]
# `external_id` should be the person's work email or their biometric enrollment id;
# `punched_at` is ISO 8601 office-local time, e.g. 2026-06-15T09:05:00
CSV_PATH=C:\Avora\punches.csv

# --- SOURCE=zk ---
ZK_HOST=192.168.1.201
ZK_PORT=4370
ZK_PASSWORD=0
# Optional CSV mapping device user-id -> external id (work email). Header:
# device_id,external_id   — recommended so punches map cleanly to employees.
MAPPING_CSV=C:\Avora\device-map.csv

# How many punches per HTTP batch, and where to remember the last-synced time.
BATCH_SIZE=500
STATE_FILE=C:\Avora\biometric-state.json
